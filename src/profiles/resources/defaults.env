# SharkDrown global Claude Code session env vars.
# Editable from Claude > Settings > Env Vars; chmod 600 on save.
#
# Lines beginning with # are comments. Each non-comment line is
# ``KEY=VALUE`` and is delivered verbatim to Claude Code sessions as
# an environment variable. ``export `` prefix is accepted and stripped.

CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
CLAUDE_CODE_NO_FLICKER=1